<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.nakielsh.foreword.refresh-claude-sessions</string>
	<key>ProgramArguments</key>
	<array>
		<string>__INSTALL_DIR__/refresh-sessions.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/refresh-claude-sessions.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/refresh-claude-sessions.log</string>
</dict>
</plist>
